root = true

[*]
indent_style = space
indent_size = 4
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

# Specific rules for TypeScript and TSX
[*.{ts,tsx}]
quote_type = single
indent_size = 4

# Documentation and configuration overrides
[*.md]
trim_trailing_whitespace = false

[package.json]
indent_size = 4
